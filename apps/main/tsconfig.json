{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "node",
    "outDir": "dist",
    "rootDir": "src",
    "composite": true,
    "paths": {
      "@dash/shared": ["../../packages/shared/src/index.ts"]
    }
  },
  "references": [{ "path": "../../packages/shared" }],
  "include": ["src/**/*"],
  // Tests never reach the shipped dist/ — vitest runs them from source
  // (vitest.config.ts), and this package's dist is what electron-builder packs.
  "exclude": ["dist", "node_modules", "src/**/*.test.ts", "test"]
}
