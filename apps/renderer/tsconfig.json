{
  "extends": "@nish/ui/tsconfig/react.json",
  "compilerOptions": {
    "target": "ES2020",
    "types": ["vite/client", "node"],
    "useDefineForClassFields": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@dash/shared": ["../../packages/shared/src/index.ts"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["dist", "node_modules"]
}
