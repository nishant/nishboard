{
  "extends": "@nish/ui/tsconfig/base.json",
  "compilerOptions": {
    // The preset is noEmit; the packages that build dist/ (shared, server, main)
    // need declarations, maps and real emit, so those deltas live here.
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  }
}
