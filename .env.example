# Keys that `packages/server/build.mjs` bakes into a locally packaged server
# (BUILTIN_KEYS). Values here never go to source or git.
SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:7432/api/spotify/callback
YOUTUBE_API_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
COINGECKO_API_KEY=
# Discord widget NATIVE mode (local RPC to the running DESKTOP Discord app).
# Create an application at discord.com/developers/applications — it must be
# owned by YOUR Discord account (owners get RPC access without a tester
# allowlist) — and register redirect http://localhost:7432/api/discord/callback.
# The embed mode needs none of this; native mode also requires the Discord
# desktop app to be running.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Read by the server in `pnpm dev`, but NEVER baked into builds (enter them in
# Settings -> Developer instead): INBOX_PASSWORD, TRADING_API_URL,
# TRADING_API_TOKEN, ALPACA_API_KEY, ALPACA_API_SECRET, ALPACA_BASE_URL,
# CLAUDE_CODE_OAUTH_TOKEN.
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=https://data.alpaca.markets/v2
INBOX_PASSWORD=
TRADING_API_URL=
TRADING_API_TOKEN=
CLAUDE_CODE_OAUTH_TOKEN=

SERVER_PORT=7432
