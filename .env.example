ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=https://data.alpaca.markets/v2
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:7432/api/spotify/callback
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Twitch only allows http for the literal host "localhost" (not 127.0.0.1).
# Redirect URI is unused by search/playback (app-token only) — kept for future user OAuth.
TWITCH_REDIRECT_URI=http://localhost:7432/api/twitch/callback
# Discord widget NATIVE mode (local RPC to the running DESKTOP Discord app).
# Create an application at discord.com/developers/applications — it must be
# owned by YOUR Discord account (owners get RPC access without a tester
# allowlist) — and register redirect http://localhost:7432/api/discord/callback.
# The embed mode needs none of this; native mode also requires the Discord
# desktop app to be running.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
SERVER_PORT=7432
